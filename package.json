{\n  "name": "bun-bunli-starter",\n  "version": "1.0.0",\n  "description": "Bun starter with Bunli CLI script for checking system files",\n  "main": "src/index.ts",\n  "scripts": {\n    "dev": "bun run src/cli.ts",\n    "check": "bun run src/cli.ts check",\n    "check:detailed": "bun run src/cli.ts check --verbose",\n    "start": "bun run src/index.ts"\n  },\n  "dependencies": {\n    "bunli": "^0.2.0"\n  },\n  "devDependencies": {\n    "@types/bun": "latest"\n  },\n  "keywords": [\n    "bun",\n    "bunli",\n    "cli",\n    "system",\n    "file-checker"\n  ]\n}